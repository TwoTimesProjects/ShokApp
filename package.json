{
  "name": "keydeck",
  "version": "2.0.0",
  "description": "KeyDeck — organize, launch, and track your game library",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^41.2.2",
    "electron-builder": "^26.8.1",
    "rcedit": "^5.0.2"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "electron-updater": "^6.3.9",
    "windows-shortcuts": "^0.1.6"
  },
  "build": {
    "appId": "com.keydeck.app",
    "productName": "KeyDeck",
    "win": {
      "target": "nsis",
      "icon": "GameLaucher.ico",
      "certificateSubjectName": "REPLACE-WITH-YOUR-CERT-SUBJECT-NAME",
      "signingHashAlgorithms": ["sha256"],
      "rfc3161TimeStampServer": "http://time.certum.pl"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KeyDeck"
    },
    "files": [
      "**/*",
      "!node_modules/electron-builder/**",
      "!*.bat",
      "!*.md"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "TwoTimesProjects",
      "repo": "KeyDeckApp"
    }
  }
}
